+//! Reader-local reuse of parsed manifests after current decryption succeeds.
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use serde_json::{Map, Value};
+
+pub(super) type CacheKey = (String, String, Vec<u8>);
+pub(super) struct VerifiedManifest {
+    pub fields: Map<String, Value>,
+    pub bytes: Vec<u8>,
+}
+#[derive(Default)]
+pub(super) struct ManifestCache {
+    pub entries: BTreeMap<CacheKey, Arc<VerifiedManifest>>,
+    bytes: usize,
+}
+impl ManifestCache {
+    pub fn insert(&mut self, key: CacheKey, value: Arc<VerifiedManifest>) {
+        const MAX_BYTES: usize = 64 * 1024 * 1024;
+        let size = value.bytes.len();
+        if size > MAX_BYTES { return; }
+        if let Some(previous) = self.entries.remove(&key) { self.bytes -= previous.bytes.len(); }
+        while self.bytes + size > MAX_BYTES {
+            if let Some((_, previous)) = self.entries.pop_first() { self.bytes -= previous.bytes.len(); }
+            else { break; }
+        }
+        self.bytes += size;
+        self.entries.insert(key, value);
+    }
+}
