+
+fn manifest_fixture() -> (GovernedReader, GovernedObject) {
+    use crate::governed::{GovernedDraft, GovernedWriter};
+    let c = Carry::new();
+    let reader = c.reader();
+    let device = crate::DeviceKey::generate();
+    let mut writer = GovernedWriter::new(&device);
+    for (name, ciphers) in &reader.groups {
+        writer = writer.with_group(name, ciphers[0].clone(), &[1; 32]).unwrap();
+    }
+    let object = writer.seal(GovernedDraft::new("data", crate::governed::testing::policy(&device)).unwrap()
+        .group("x", serde_json::json!({"from": "source"})).unwrap().manifest("x").unwrap()).unwrap();
+    (reader, object)
+}
+
+#[test]
+fn verified_manifest_is_parsed_once_while_each_use_is_authorized() {
+    let (reader, object) = manifest_fixture();
+    DECRYPTED_GROUP_PARSES.with(|n| n.set(0));
+    let mut decisions = 0;
+    for _ in 0..2 {
+        let data = reader.receive_for(&object, &usage(), ["x"], None, |_| {
+            decisions += 1; Ok(true)
+        }).unwrap();
+        assert_eq!(data.group("x").unwrap()["from"], "source");
+    }
+    assert_eq!(decisions, 2);
+    assert_eq!(DECRYPTED_GROUP_PARSES.with(|n| n.get()), 3,
+               "governance opens on each use; the immutable manifest parses once");
+    assert!(reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(false)).is_err());
+}
+
+#[test]
+fn mutating_a_received_copy_does_not_change_cached_source_fields() {
+    let (reader, object) = manifest_fixture();
+    let mut first = reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(true)).unwrap();
+    first.set_field("x", "from", serde_json::json!("changed")).unwrap();
+    let second = reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(true)).unwrap();
+    assert_eq!(second.group("x").unwrap()["from"], "source");
+}
+
+#[test]
+fn opened_groups_move_into_the_working_copy() {
+    let (reader, object) = manifest_fixture();
+    let admitted = reader.governance(&object).unwrap().accept(
+        usage(), ["x"], |_| Ok(true)).unwrap();
+    let opened = reader.open(&admitted, ["x"]).unwrap();
+    let pointer = opened.groups()["x"]["from"].as_str().unwrap().as_ptr();
+    let data = crate::governed::DataObject::from_opened(opened).unwrap();
+    assert_eq!(pointer, data.group("x").unwrap()["from"].as_str().unwrap().as_ptr(),
+               "receipt must move owned plaintext rather than allocate another group copy");
+}
+
+#[test]
+fn cached_manifest_does_not_bypass_current_cipher_entitlement() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    struct Revocable {
+        inner: Arc<dyn GroupCipher>,
+        blocked: Arc<AtomicBool>,
+    }
+    impl GroupCipher for Revocable {
+        fn kind(&self) -> &'static str { self.inner.kind() }
+        fn encrypt(&self, bytes: &[u8]) -> Result<Vec<u8>> { self.inner.encrypt(bytes) }
+        fn decrypt(&self, bytes: &[u8]) -> Result<Vec<u8>> { self.inner.decrypt(bytes) }
+        fn decrypt_with_aad(&self, bytes: &[u8], aad: &[u8]) -> Result<Vec<u8>> {
+            if self.blocked.load(Ordering::SeqCst) {
+                return Err(Error::NotEntitled { group: "x".to_owned() });
+            }
+            self.inner.decrypt_with_aad(bytes, aad)
+        }
+    }
+    let (mut reader, object) = manifest_fixture();
+    let blocked = Arc::new(AtomicBool::new(false));
+    let original = reader.groups["x"][0].clone();
+    reader.groups.get_mut("x").unwrap()[0] = Arc::new(Revocable { inner: original, blocked: blocked.clone() });
+    reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(true)).unwrap();
+    blocked.store(true, Ordering::SeqCst);
+    assert!(reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(true)).is_err());
+}
+
+#[test]
+fn adding_an_index_key_rechecks_cached_fields() {
+    let (original, object) = manifest_fixture();
+    let mut reader = GovernedReader::new();
+    for (name, ciphers) in &original.groups {
+        reader = reader.with_group(name, ciphers[0].clone()).unwrap();
+    }
+    reader = reader.with_governance_index_key(&[1; 32]).unwrap();
+    reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(true)).unwrap();
+    let reader = reader.with_group_index_key("x", &[99; 32]).unwrap();
+    assert!(reader.receive_for(&object, &usage(), ["x"], None, |_| Ok(true)).is_err());
+}
