+            "a": [0, -3, 0.125], "quoted\"key": "value"
+        }).as_object().unwrap().clone();
+        let mut names = Vec::new();
+        let bytes = canonical_object_fields(&fields, |name, encoded| {
+            assert_eq!(encoded, canonical_bytes(&fields[name])?);
+            names.push(name.to_owned());
+            Ok(())
+        }).unwrap();
+        assert_eq!(bytes, canonical_bytes(&Value::Object(fields.clone())).unwrap());
+        assert_eq!(names.len(), fields.len());
+        assert!(names.windows(2).all(|pair| pair[0] < pair[1]));
+    }
