+/// Encode once, exposing each field's canonical bytes before advancing.
+pub(crate) fn canonical_object_fields(
+    fields: &Map<String, Value>,
+    mut field_encoded: impl FnMut(&str, &[u8]) -> Result<()>,
+) -> Result<Vec<u8>> {
+    let mut out = Vec::with_capacity(64);
+    out.push(b'{');
+    let mut keys: Vec<&String> = fields.keys().collect();
+    keys.sort();
+    for (i, key) in keys.into_iter().enumerate() {
+        if i > 0 { out.push(b','); }
+        write_json_string(key, &mut out);
+        out.push(b':');
+        let start = out.len();
+        encode(&fields[key], &mut out)?;
+        field_encoded(key, &out[start..])?;
+    }
+    out.push(b'}');
+    Ok(out)
+}
