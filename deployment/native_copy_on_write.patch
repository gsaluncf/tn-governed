+pub(crate) fn canonical_object_bytes(fields: &Map<String, Value>) -> Result<Vec<u8>> {
+    let mut out = Vec::with_capacity(64);
+    encode_object(fields, &mut out)?;
+    Ok(out)
+}
+
+fn encode_object(m: &Map<String, Value>, out: &mut Vec<u8>) -> Result<()> {
+    out.push(b'{');
+    let mut keys: Vec<&String> = m.keys().collect();
+    keys.sort();
+    for (i, k) in keys.iter().enumerate() {
+        if i > 0 {
+            out.push(b',');
         }
+        write_json_string(k, out);
+        out.push(b':');
+        encode(&m[*k], out)?;
     }
+    out.push(b'}');
     Ok(())
 }
 
