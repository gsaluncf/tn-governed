+#[test]
+fn working_copies_share_immutable_groups_until_edited() {
+    let c = Carry::new();
+    let object = c.seal(&["keep"], vec![]);
+    let data = c.reader().receive_for(&object, &crate::governed::testing::usage(), ["keep"], None, |_| Ok(true)).unwrap();
+    let mut copy = data.clone();
+    assert!(std::ptr::eq(data.groups(), copy.groups()), "working copies must share immutable group storage");
+    copy.set_field("keep", "from", json!("edited")).unwrap();
+    assert_eq!(data.group("keep").unwrap()["from"], "keep");
+    assert_eq!(copy.group("keep").unwrap()["from"], "edited");
+}
