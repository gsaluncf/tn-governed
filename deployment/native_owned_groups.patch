+#[test]
+fn owned_group_creation_validates_groups_and_preserves_nested_values() {
+    let device = crate::DeviceKey::generate();
+    let policy = crate::governed::testing::policy(&device);
+    let groups = json!({"keep": {"nested": {"items": [1, true, "text"]}}});
+    let data = super::DataObject::new_with_owned_groups("data", policy.clone(), groups.as_object().unwrap().clone()).unwrap();
+    assert_eq!(data.get("keep", Some("nested")).unwrap(), json!({"items": [1, true, "text"]}));
+    for bad in [json!({}), json!({"tn.agents": {}}), json!({"keep": []})] {
+        assert!(super::DataObject::new_with_owned_groups("data", policy.clone(), bad.as_object().unwrap().clone()).is_err());
+    }
